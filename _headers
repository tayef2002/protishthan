# Cloudflare Pages: extra response headers (static files only).
# Pictures and fonts rarely change: let the browser keep them for a day (faster repeat visits, better page-speed scores).
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.woff2
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
# NOTE for scripts (.js): Cloudflare's zone setting "Browser Cache TTL" (4 hours) raises any shorter max-age, so a phone can keep an older script for 4 hours.
# A shorter value here does nothing; change the ?v= number in the page that loads the script every time the script changes (iab.js, card-index.js, phon.js, bnname.js ...).
# The saved name index of the card page (card-index/): small text files for the browser, not pages for search engines. A day in the browser; the page asks for them with ?v=<INDEX_VERSION>.
/card-index/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Robots-Tag: noindex
